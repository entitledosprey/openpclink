# Link G5 (USB CDC): let the logged-in user open it, and stop ModemManager
# sending AT commands to an engine controller.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="a451", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
# Link G4X (FTDI with private product IDs, driven through libusb).
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="706[89a-f]", TAG+="uaccess"
